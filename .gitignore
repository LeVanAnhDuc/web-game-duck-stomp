
# Bí mật — `.env.example` là bản mẫu và ĐƯỢC commit; `.env` là bản thật và không bao giờ commit.
.env
.env.*
!.env.example

# Mockup UI — CỐ Ý không vào repo.
# Canvas là một Artifact trên claude.ai; nguồn `.dc.html` + bundle đã seed chỉ là
# công cụ trung gian. Cái gì hiện thực làm thì nằm trong code, cái gì giải thích
# tại sao thì nằm trong docs/specs/ và docs/decisions/.
/.design/

# Node
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# Playwright MCP scratch output
/.playwright-mcp/

# Ảnh chụp khi kiểm bằng tay. Ảnh THẬT của repo nằm ở docs/assets/ và assets/;
# không có PNG nào thuộc về thư mục gốc. Luật này tồn tại vì ba ảnh debug đã
# từng bị `git add -A` quét vào một commit (xem 74ada68).
/*.png
/*.jpg
/*.webp

# --- Claude Code: theo doi config + skills, bo qua worktrees/doc-state ---
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.local.json
!/.claude/skills/
!/.claude/scripts/
# Hai agent cua ux-persona-review. Khong track thi ban clone moi khong co chung,
# va lan chay dau tien that bai voi "agent type not found" — mot loi rat kho doan.
!/.claude/agents/

# Repo nay dung npm (package-lock.json). Mot yarn.lock lot vao la hai lockfile
# trong mot repo: CI cai bang mot cai, nguoi dev cai bang cai kia.
yarn.lock
